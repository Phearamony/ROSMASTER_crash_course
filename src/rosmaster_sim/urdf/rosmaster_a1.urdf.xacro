<?xml version="1.0"?>
<robot name="rosmaster_a1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" value="0.034"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheelbase" value="0.16"/>
  <xacro:property name="track_half" value="0.0845"/>
  <xacro:property name="max_steer" value="0.5"/>

  <material name="body_gray"><color rgba="0.45 0.48 0.53 1"/></material>
  <material name="dark"><color rgba="0.12 0.13 0.15 1"/></material>
  <material name="wheel_blue"><color rgba="0.12 0.43 0.82 1"/></material>
  <material name="light"><color rgba="0.85 0.87 0.9 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.24 0.13 0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="-0.01 0 0.095"/>
      <geometry><box size="0.20 0.12 0.07"/></geometry>
      <material name="body_gray"/>
    </visual>
    <visual>
      <origin xyz="0.105 0 0.09"/>
      <geometry><box size="0.03 0.05 0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.24 0.13 0.12"/></geometry>
    </collision>
    <xacro:box_inertia m="1.2" x="0.24" y="0.13" z="0.12"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.018"/>
      <geometry><cylinder radius="0.025" length="0.008"/></geometry>
      <material name="wheel_blue"/>
    </visual>
    <xacro:box_inertia m="0.1" x="0.07" y="0.07" z="0.03"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.02 0 0.148"/>
  </joint>

  <gazebo reference="laser_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:macro name="wheel" params="name">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_blue"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.000028" ixy="0" ixz="0" iyy="0.000046" iyz="0" izz="0.000028"/>
      </inertial>
    </link>
    <gazebo reference="${name}_wheel">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="rear_left"/>
  <xacro:wheel name="rear_right"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="${-wheelbase/2} ${track_half} 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="${-wheelbase/2} ${-track_half} 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:macro name="steer_hub" params="side y">
    <link name="front_${side}_hub">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
      </inertial>
    </link>
    <joint name="front_${side}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_hub"/>
      <origin xyz="${wheelbase/2} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-max_steer}" upper="${max_steer}" effort="10" velocity="5"/>
    </joint>
    <xacro:wheel name="front_${side}"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_hub"/>
      <child link="front_${side}_wheel"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:steer_hub side="left" y="${track_half}"/>
  <xacro:steer_hub side="right" y="${-track_half}"/>

  <link name="steering_wheel">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steering_wheel"/>
    <origin xyz="0.05 0 0.05"/>
    <axis xyz="1 0 0"/>
    <limit lower="-7.85" upper="7.85" effort="1" velocity="10"/>
  </joint>

  <gazebo reference="laser_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <gazebo>
    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <update_rate>100.0</update_rate>

      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <steering_wheel_joint>steering_joint</steering_wheel_joint>

      <max_steer>${max_steer}</max_steer>
      <max_steering_angle>7.85</max_steering_angle>
      <max_speed>0.6</max_speed>

      <left_steering_pid_gain>1.0 0 0.01</left_steering_pid_gain>
      <left_steering_i_range>0 0</left_steering_i_range>
      <right_steering_pid_gain>1.0 0 0.01</right_steering_pid_gain>
      <right_steering_i_range>0 0</right_steering_i_range>
      <linear_velocity_pid_gain>0.15 0 0</linear_velocity_pid_gain>
      <linear_velocity_i_range>0 0</linear_velocity_i_range>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_distance>false</publish_distance>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>front_left_steer_joint</joint_name>
      <joint_name>front_right_steer_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>steering_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
